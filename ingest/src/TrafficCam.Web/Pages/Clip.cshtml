@page "/clips/{id:guid}"
@model ClipModel
@{
    ViewData["Title"] = "Clip";
    var clip = Model.Clip;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
}
@if (clip.DeletedAt is { } deleted)
{
    <p>This clip was deleted on <time datetime="@deleted.UtcDateTime.ToString("o")">@Wording.Utc(deleted)</time>.</p>
}
else
{
    <video controls autoplay muted playsinline preload="metadata"
           poster="@(clip.StillPath is null ? null : $"/clips/{clip.Id}/still")"
           src="/clips/@clip.Id/video#t=@Model.From.ToString("0.#", invariant)"></video>
}
<h1><time datetime="@clip.StartedAt.UtcDateTime.ToString("o")">@Wording.Utc(clip.StartedAt)</time></h1>
<p class="detail">
    @Wording.Length(clip.LengthSeconds), @((clip.Bytes / 1e6).ToString("0.#", invariant)) MB
    @if (clip.Archived)
    {
        <span class="tag">archived</span>
    }
    @if (clip.FalsePositive)
    {
        <span class="tag">false positive</span>
    }
</p>
@if (clip.DeletedAt is null)
{
    <form method="post" asp-page-handler="Describe" class="describe">
        <input name="description" value="@clip.Description" maxlength="@ClipMarks.DescriptionLength"
               placeholder="Describe this clip" aria-label="Description">
        <button>Save</button>
    </form>
    <div class="actions">
        <form method="post" asp-page-handler="Archive">
            <input type="hidden" name="on" value="@(clip.Archived ? "false" : "true")">
            <button>@(clip.Archived ? "Unarchive" : "Archive")</button>
        </form>
        <form method="post" asp-page-handler="FalsePositive">
            <input type="hidden" name="on" value="@(clip.FalsePositive ? "false" : "true")">
            <button>@(clip.FalsePositive ? "Not a false positive" : "False positive")</button>
        </form>
    </div>
}
else if (clip.Description is not null)
{
    <p>@clip.Description</p>
}
<table>
    <thead>
        <tr><th>What</th><th>When</th><th>In the clip</th><th>Detail</th></tr>
    </thead>
    <tbody>
        @foreach (var trigger in Model.Triggers)
        {
            <tr>
                <td><a href="/types/@trigger.Type">@Wording.Title(trigger.Type)</a></td>
                <td><time datetime="@trigger.At.UtcDateTime.ToString("o")">@Wording.Utc(trigger.At)</time></td>
                <td>
                    <button type="button" data-seek="@Math.Max(0, trigger.OffsetSeconds).ToString("0.##", invariant)">
                        @trigger.OffsetSeconds.ToString("0.0", invariant) s
                    </button>
                </td>
                <td>@trigger.Detail</td>
            </tr>
        }
    </tbody>
</table>
