<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Traffic camera clips</title>
    <link rel="stylesheet" href="~/site.css" asp-append-version="true">
</head>
<body>
    <header>
        <a href="/">Traffic camera clips</a>
        <form method="post" asp-page="/Index" asp-page-handler="Archived">
            <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)">
            <label>
                <input type="checkbox" name="include" value="true" checked="@Context.Request.IncludeArchived()" data-submit>
                Include archived clips
            </label>
            <noscript><button>Apply</button></noscript>
        </form>
        <form method="post" asp-page="/Index" asp-page-handler="QuickClip">
            <button title="Save what the camera has just seen as a clip">Quick clip</button>
        </form>
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="~/site.js" asp-append-version="true"></script>
</body>
</html>
