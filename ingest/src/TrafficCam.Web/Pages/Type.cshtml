@page "/types/{type}"
@model TypeModel
@{
    ViewData["Title"] = Wording.Title(Model.Type);
}
<h1>@Wording.Title(Model.Type)</h1>
@if (Model.Waiting)
{
    <p class="notice" data-reload-after="2">A clip of the last moments was asked for. It will be here in a few seconds.</p>
}
@if (Model.Missing)
{
    <p class="notice">The clip that was asked for has not arrived. The camera service may be down.</p>
}
@if (Model.Entries.Count == 0)
{
    <p>No clips.</p>
}
<ol class="entries wide">
    @foreach (var entry in Model.Entries)
    {
        <partial name="_Entry" model="entry" />
    }
</ol>
@if (Model.Older is { } older)
{
    <a class="more" href="/types/@Model.Type?before=@Uri.EscapeDataString(older.UtcDateTime.ToString("o"))">Older</a>
}
