# systemd user unit, installed to ~/.config/systemd/user by `just deploy`.
# Runs at boot without a login session once lingering is enabled for the user.

[Unit]
Description=Traffic camera vision service

[Service]
Environment=VISION_ARGS=
# MQTT_PASSWORD for the broker, and VISION_ARGS for extra flags such as --debug-rerun.
EnvironmentFile=%h/trafficcam/deploy/.env
ExecStart=%h/trafficcam/vision/.venv/bin/python -m trafficcam \
    --config %h/trafficcam/config/site.yaml \
    --record-tracks /mnt/data/tracklogs \
    $VISION_ARGS
Restart=always
RestartSec=5
# Status 2 means the config is invalid; restarting would not fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
