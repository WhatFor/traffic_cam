{
  "uid": "speed",
  "title": "Speed",
  "tags": [
    "trafficcam"
  ],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Passages with a speed",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT avg((speed_kmh IS NOT NULL)::int) FROM passages WHERE $__timeFilter(first_seen)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Speed is measured only among the calibrated points, and needs a second of unbroken tracking there.",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Median",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY speed_kmh / 1.609344) FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "velocitymph"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "85th percentile",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT percentile_cont(0.85) WITHIN GROUP (ORDER BY speed_kmh / 1.609344) FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "velocitymph"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "The speed that 85 in 100 vehicles do not exceed.",
      "id": 3,
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Over 30 mph",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT avg((speed_kmh / 1.609344 > 30)::int) FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Share of measured passages over the limit. Readings are good to about 10%.",
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Over 35 mph",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT count(*) FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL AND speed_kmh / 1.609344 > 35",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Each of these raised a speeding event.",
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Fastest",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT max(speed_kmh / 1.609344) FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "velocitymph"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "id": 6,
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "barchart",
      "title": "Sustained speeds",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT (floor(speed_kmh / 1.609344 / 2.5) * 2.5)::text AS mph, count(*) AS passages FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL GROUP BY floor(speed_kmh / 1.609344 / 2.5) ORDER BY floor(speed_kmh / 1.609344 / 2.5)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "mph",
        "barWidth": 0.95,
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "How many passages had each speed: the fastest each held for one second, in 2.5 mph bands named by their lower edge. The limit is 30 mph.",
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "By movement",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT coalesce(movement, 'unknown') AS movement, count(*) AS passages, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY speed_kmh / 1.609344)::numeric, 1) AS \"median (mph)\", round(percentile_cont(0.85) WITHIN GROUP (ORDER BY speed_kmh / 1.609344)::numeric, 1) AS \"85th (mph)\", round(max(speed_kmh / 1.609344)::numeric, 1) AS \"fastest (mph)\" FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 8,
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Speed over time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time_bucket('15 minutes', first_seen) AS \"time\", percentile_cont(0.5) WITHIN GROUP (ORDER BY speed_kmh / 1.609344) AS \"median\", percentile_cont(0.85) WITHIN GROUP (ORDER BY speed_kmh / 1.609344) AS \"85th percentile\", max(speed_kmh / 1.609344) AS \"fastest\" FROM passages WHERE $__timeFilter(first_seen) AND speed_kmh IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitymph",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "auto",
            "fillOpacity": 0,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Per 15 minutes. The red line is the limit.",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Stretch averages, by signal",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT stretch.key AS stretch, coalesce(signal_state_at_crossing, 'no signal read') AS \"crossed on\", count(*) AS passages, round(percentile_cont(0.5) WITHIN GROUP (ORDER BY stretch.value::float8 / 1.609344)::numeric, 1) AS \"median (mph)\", round(percentile_cont(0.85) WITHIN GROUP (ORDER BY stretch.value::float8 / 1.609344)::numeric, 1) AS \"85th (mph)\" FROM passages, jsonb_each_text(flags->'speed'->'stretch_kmh') AS stretch WHERE $__timeFilter(first_seen) GROUP BY 1, 2 ORDER BY 1, 3 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Average speed from entering a marked stretch to leaving it. A vehicle that queued in it reads low, so the signal it crossed on separates free-flowing traffic from the rest.",
      "id": 10,
      "gridPos": {
        "x": 14,
        "y": 13,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Latest speeding events",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", (attrs->>'speed_mph')::numeric AS \"mph\", attrs->>'movement' AS movement, class, CASE WHEN clip_id IS NULL THEN '' ELSE '/clips/' || clip_id END AS \"clip (on the clips site)\" FROM events WHERE $__timeFilter(ts) AND type = 'speeding' ORDER BY ts DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Passages faster than 35 mph. A clip is kept from 45 mph.",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      }
    }
  ]
}
