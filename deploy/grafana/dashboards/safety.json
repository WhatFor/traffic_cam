{
  "uid": "safety",
  "title": "Safety",
  "tags": [
    "trafficcam"
  ],
  "schemaVersion": 41,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "Near misses",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT count(*) FROM events WHERE $__timeFilter(ts) AND type = 'near_miss'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Two road users on crossing paths whose tracked points reached the same spot less than 2 s apart. Each is one point, so their bodies were about half a second closer than the time says.",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Under 1.5 seconds",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT count(*) FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' AND (attrs->>'pet_s')::float8 < 1.5",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "Each of these has a clip.",
      "id": 2,
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Closest",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT min((attrs->>'pet_s')::float8) FROM events WHERE $__timeFilter(ts) AND type = 'near_miss'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Incident candidates",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT count(*) FROM events WHERE $__timeFilter(ts) AND type = 'incident_candidate'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "description": "What a crash might look like in the tracks. Most will not be one; each has a clip to look at.",
      "id": 4,
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Near misses per hour",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT time_bucket('1 hour', ts) AS \"time\", CASE WHEN (attrs->>'pet_s')::float8 < 1.5 THEN 'under 1.5 s' ELSE '1.5 to 2 s' END AS metric, count(*) AS near_misses FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' GROUP BY 1, 2 ORDER BY 1, 2",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 0,
            "barAlignment": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 9
      }
    },
    {
      "type": "barchart",
      "title": "How far apart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT to_char(floor((attrs->>'pet_s')::float8 * 10) / 10, 'FM0.0') AS seconds, count(*) AS near_misses FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' GROUP BY floor((attrs->>'pet_s')::float8 * 10) ORDER BY floor((attrs->>'pet_s')::float8 * 10)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "min": 0,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "xField": "seconds",
        "barWidth": 0.95,
        "showValue": "never",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "The time between the first leaving the spot and the second reaching it, in tenths of a second.",
      "id": 6,
      "gridPos": {
        "x": 14,
        "y": 4,
        "w": 10,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Which movements meet",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT coalesce(attrs->'movements'->>0, 'unknown') AS \"first through\", coalesce(attrs->'movements'->>1, 'unknown') AS \"then\", count(*) AS \"near misses\", count(*) FILTER (WHERE (attrs->>'pet_s')::float8 < 1.5) AS \"under 1.5 s\", round(percentile_cont(0.5) WITHIN GROUP (ORDER BY (attrs->>'pet_s')::float8)::numeric, 2) AS \"median gap (s)\" FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' GROUP BY 1, 2 ORDER BY 3 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Where",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT (round((attrs->'ground_m'->>0)::numeric / 3) * 3)::int AS \"metres east\", (round((attrs->'ground_m'->>1)::numeric / 3) * 3)::int AS \"metres north\", count(*) AS \"near misses\", round(min((attrs->>'pet_s')::float8)::numeric, 2) AS \"closest (s)\" FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' GROUP BY 1, 2 ORDER BY 3 DESC LIMIT 20",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Near misses grouped into 3 m squares, in metres from the box junction's north-west corner.",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Latest near misses",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", (attrs->>'pet_s')::float8 AS \"gap (s)\", attrs->'movements'->>0 AS \"first through\", attrs->'movements'->>1 AS \"then\", (attrs->'speeds_mph'->>0)::numeric AS \"first (mph)\", (attrs->'speeds_mph'->>1)::numeric AS \"second (mph)\", (attrs->>'angle_deg')::int AS \"angle\", CASE WHEN clip_id IS NULL THEN '' ELSE '/clips/' || clip_id END AS \"clip (on the clips site)\" FROM events WHERE $__timeFilter(ts) AND type = 'near_miss' ORDER BY ts DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Incident candidates",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", confidence, (SELECT string_agg(replace(sign, '_', ' '), ', ') FROM jsonb_array_elements_text(attrs->'signs') AS sign) AS \"what was seen\", (attrs->>'pet_s')::float8 AS \"gap (s)\", (attrs->>'standing_s')::int AS \"stood (s)\", CASE WHEN clip_id IS NULL THEN '' ELSE '/clips/' || clip_id END AS \"clip (on the clips site)\" FROM events WHERE $__timeFilter(ts) AND type = 'incident_candidate' ORDER BY ts DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "Confidence is 0.5 for a lone long standstill and rises with each sign after a contact: a sudden stop, one vehicle staying put, both staying put.",
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 8
      }
    }
  ]
}
