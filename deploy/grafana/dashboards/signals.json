    {
      "type": "table",
      "title": "Latest red-light and amber events",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", type, replace(attrs->>'line', 'stopline_', '') AS line, attrs->>'movement' AS movement, coalesce(attrs->>'time_into_red_s', attrs->>'time_into_amber_s')::numeric AS \"into state (s)\" FROM events WHERE $__timeFilter(ts) AND type IN ('red_light', 'amber_crossing') ORDER BY ts DESC LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
