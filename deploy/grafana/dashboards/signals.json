          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT count(*) FROM events WHERE $__timeFilter(ts) AND type = 'red_light'",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
