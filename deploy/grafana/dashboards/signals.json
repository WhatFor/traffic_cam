      }
    },
    {
      "type": "table",
      "title": "Banned turns and the signals",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", attrs->>'turn' AS turn, head.key AS head, head.value->>'at_start' AS \"at start\", (head.value->>'green_s')::numeric AS \"green during turn (s)\" FROM events, jsonb_each(attrs->'signals') AS head WHERE $__timeFilter(ts) AND type = 'banned_turn' ORDER BY ts DESC, 3 LIMIT 100",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
