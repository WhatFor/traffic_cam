      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT replace(stopline, 'stopline_', '') AS line, coalesce(signal_state_at_crossing, 'no heads') AS signal, count(*) AS crossings FROM passages WHERE $__timeFilter(first_seen) AND stopline IS NOT NULL GROUP BY 1, 2 ORDER BY 1, 3 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          },
          "mappings": [
            {
              "type": "value",
