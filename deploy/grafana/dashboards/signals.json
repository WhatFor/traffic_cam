        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.85,
        "alignValue": "left",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "description": "What was read from each head's lamps, right or wrong. Each head's state over time. Zoom in to a few minutes to see single cycles.",
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 9
