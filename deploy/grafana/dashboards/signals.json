                },
                "green": {
                  "color": "green",
                  "index": 2,
                  "text": "green"
                },
                "amber": {
                  "color": "yellow",
                  "index": 3,
                  "text": "amber"
                },
                "unknown": {
                  "color": "#808080",
                  "index": 4,
                  "text": "unknown"
                }
              }
            }
          ],
          "displayName": "${__field.labels.head_id}"
