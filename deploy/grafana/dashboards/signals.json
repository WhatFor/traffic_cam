    {
      "type": "stat",
      "title": "Crossings with a known signal",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT avg((signal_state_at_crossing NOT IN ('unknown'))::int) FROM passages WHERE $__timeFilter(first_seen) AND stopline IS NOT NULL AND signal_state_at_crossing IS NOT NULL",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
