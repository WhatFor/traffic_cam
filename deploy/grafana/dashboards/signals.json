        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "How long each green lasted, per head.",
      "id": 8,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Share of time unknown",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH spans AS ( SELECT head_id, to_state AS state, ts, extract(epoch FROM lead(ts) OVER (PARTITION BY head_id ORDER BY ts) - ts) AS lasted FROM signal_changes WHERE $__timeFilter(ts)) SELECT head_id AS head, round((100 * coalesce(sum(lasted) FILTER (WHERE state = 'unknown'), 0) / sum(lasted))::numeric, 1) AS \"unknown (%)\", count(*) FILTER (WHERE state = 'unknown') AS times FROM spans WHERE lasted IS NOT NULL GROUP BY 1 ORDER BY 1",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "description": "How much of the period each head could not be read.",
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 6,
        "h": 8
      }
    },
    {
