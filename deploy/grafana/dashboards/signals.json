    {
      "type": "table",
      "title": "How long each state lasts",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH spans AS ( SELECT head_id, to_state AS state, ts, extract(epoch FROM lead(ts) OVER (PARTITION BY head_id ORDER BY ts) - ts) AS lasted FROM signal_changes WHERE $__timeFilter(ts)) SELECT head_id AS head, state, count(*) AS times, round(avg(lasted)::numeric, 1) AS \"mean (s)\", round(min(lasted)::numeric, 1) AS \"shortest (s)\", round(max(lasted)::numeric, 1) AS \"longest (s)\" FROM spans WHERE lasted IS NOT NULL GROUP BY 1, 2 ORDER BY 1, 2",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "minWidth": 50
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Cycle length",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "SELECT ts AS \"time\", head_id AS metric, extract(epoch FROM ts - lag(ts) OVER (PARTITION BY head_id ORDER BY ts)) AS cycle FROM signal_changes WHERE to_state = 'green' AND $__timeFilter(ts) ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Time from one start of green to the next, per head.",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Green time",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "rawSql": "WITH spans AS ( SELECT head_id, to_state AS state, ts, extract(epoch FROM lead(ts) OVER (PARTITION BY head_id ORDER BY ts) - ts) AS lasted FROM signal_changes WHERE $__timeFilter(ts)) SELECT ts AS \"time\", head_id AS metric, lasted AS green FROM spans WHERE state = 'green' AND lasted IS NOT NULL ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "showPoints": "always",
            "pointSize": 4,
            "fillOpacity": 0
          }
