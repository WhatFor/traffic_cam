# Copy to deploy/.env (git-ignored) and fill in.
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
MQTT_PASSWORD=

# Alert emails from Grafana. SMTP_HOST is host:port and must offer STARTTLS;
# SMTP_USER is also the sender address.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# How you reach Grafana, for the links in those emails, e.g. http://pi:3000
GRAFANA_ROOT_URL=
# Extra flags for the vision service. Uncomment to serve the Rerun debug view on port 9876.
# VISION_ARGS=--debug-rerun
